generator client {
  provider = "prisma-client-js"
}

// Client D1 dedicato al runtime Cloudflare Workers (CF2): usa i driver
// adapter (@prisma/adapter-d1) e il query compiler WASM (engineType "client"),
// quindi nessun engine binario Node da bundle. Il client classico per
// Node/SQLite resta quello sopra (default, @prisma/client).
generator clientD1 {
  provider        = "prisma-client-js"
  output          = "./d1client"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Project {
  id        String   @id @default(cuid())
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  tasks  Task[]
  tokens ProjectToken[]
}

model ProjectToken {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  tokenHash String    @unique
  label     String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model Task {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])

  title       String
  description String   @default("")
  status      String   @default("draft") // draft | in_progress | done
  priority    String   @default("medium") // low | medium | high | urgent
  complexity  Int?
  tags        String   @default("") // comma-separated
  dueDate     DateTime?
  position    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments     Comment[]
  attachments  Attachment[]
  blockedBy    TaskDependency[] @relation("BlockedTask")
  blocking     TaskDependency[] @relation("BlockerTask")
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  task            Task   @relation("BlockedTask", fields: [taskId], references: [id])
  blockedByTaskId String
  blockedByTask   Task   @relation("BlockerTask", fields: [blockedByTaskId], references: [id])

  @@unique([taskId, blockedByTaskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// Singleton (id sempre "singleton"): configurazione globale del backend di
// storage per gli allegati, modificabile da UI invece che solo via .env
// (vedi apps/server/src/lib/attachmentStorage/index.ts).
model StorageSettings {
  id               String   @id @default("singleton")
  backend          String   @default("local") // local | s3
  localDir         String   @default("./attachments/local")
  s3Endpoint       String?
  s3Bucket         String?
  s3Region         String?
  s3AccessKeyId    String?
  s3SecretAccessKey String?
  updatedAt        DateTime @updatedAt
}

model Attachment {
  id              String @id @default(cuid())
  taskId          String
  task            Task   @relation(fields: [taskId], references: [id])
  fileName        String
  mimeType        String
  size            Int      @default(0)
  storageBackend  String // local | s3
  storageRef      String
  createdAt       DateTime @default(now())
}
