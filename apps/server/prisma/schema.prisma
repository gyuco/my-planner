generator client {
  provider = "prisma-client-js"
}

// Client D1 dedicato al runtime Cloudflare Workers (CF2): usa i driver
// adapter (@prisma/adapter-d1) e il query compiler WASM (engineType "client"),
// quindi nessun engine binario Node da bundle. Il client classico per
// Node/SQLite resta quello sopra (default, @prisma/client).
generator clientD1 {
  provider        = "prisma-client-js"
  output          = "./d1client"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  // L'email e' l'unico identificativo di accesso (sostituisce lo username).
  // Unica e sempre valorizzata: usata per il login e mostrata nel profilo.
  email        String @unique
  passwordHash String
  // Dati anagrafici mostrati nella pagina profilo. I default vuoti mantengono
  // validi gli utenti creati prima dell'introduzione del profilo (la UI fa
  // fallback sull'email quando nome/cognome non sono stati compilati).
  firstName    String @default("")
  lastName     String @default("")
  // Ruolo applicativo: "admin" vede/modifica tutto, "manager" accede solo ai
  // progetti associati tramite UserProject. Default "admin" perche' il primo
  // utente creato al bootstrap e gli utenti pre-ruoli sono amministratori.
  role         String @default("admin")
  createdAt    DateTime @default(now())

  projects UserProject[]
  notificationState NotificationState?
  taskEvents TaskEvent[]
  assignedTasks Task[] @relation("TaskAssignee")
  ownedTasks    Task[] @relation("TaskOwner")
}

// Associazione manager <-> progetto (molti-a-molti). Per gli admin non viene
// usata: il ruolo admin ha accesso implicito a tutti i progetti.
model UserProject {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  tasks   Task[]
  tokens  ProjectToken[]
  members UserProject[]
  events  TaskEvent[]
}

model ProjectToken {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  tokenHash String    @unique
  label     String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model Task {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])

  title       String
  description String   @default("")
  status      String   @default("draft") // draft | todo | in_progress | testing | done
  type        String   @default("feature") // bug | feature | analysis
  priority    String   @default("medium") // low | medium | high | urgent
  complexity  Int?
  tags        String   @default("") // comma-separated
  dueDate     DateTime?
  position    Int      @default(0)

  // Assegnatario (opzionale) e owner, cioe' chi ha creato il task (null se
  // creato via MCP/sistema). Non limitano la visibilita': servono a filtri
  // come "assegnati a me". SetNull: cancellare un utente lascia i suoi task
  // senza assegnatario/owner invece di eliminarli.
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  ownerId    String?
  owner      User?   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Sotto-task: un solo livello di annidamento (una subtask non puo' a sua
  // volta avere subtasks, vedi validazione in taskService.ts). Nessun
  // onDelete cascade: deleteTask rifiuta la cancellazione di un parent con
  // subtasks ancora presenti, cosi' non si perdono dati per errore.
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id])
  subtasks Task[]  @relation("Subtasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments     Comment[]
  attachments  Attachment[]
  blockedBy    TaskDependency[] @relation("BlockedTask")
  blocking     TaskDependency[] @relation("BlockerTask")

  @@index([assigneeId])
  @@index([ownerId])
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  task            Task   @relation("BlockedTask", fields: [taskId], references: [id])
  blockedByTaskId String
  blockedByTask   Task   @relation("BlockerTask", fields: [blockedByTaskId], references: [id])

  @@unique([taskId, blockedByTaskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// Singleton (id sempre "singleton"): configurazione globale del backend di
// storage per gli allegati, modificabile da UI invece che solo via .env
// (vedi apps/server/src/lib/attachmentStorage/index.ts).
model StorageSettings {
  id               String   @id @default("singleton")
  backend          String   @default("local") // local | s3
  localDir         String   @default("./attachments/local")
  s3Endpoint       String?
  s3Bucket         String?
  s3Region         String?
  s3AccessKeyId    String?
  s3SecretAccessKey String?
  updatedAt        DateTime @updatedAt
}

// Singleton (id sempre "singleton"): configurazione SMTP per le email di
// notifica, modificabile dalla UI admin. La password non e' mai salvata in
// chiaro: `passwordEnc` e' cifrata AES-GCM con una chiave derivata da
// SETTINGS_ENCRYPTION_KEY (fallback JWT_SECRET), vedi lib/secretBox.ts.
// Riga assente / `enabled` false / campi incompleti => nessuna email inviata.
model EmailSettings {
  id          String   @id @default("singleton")
  enabled     Boolean  @default(false)
  host        String?
  port        Int      @default(465)
  security    String   @default("tls") // tls | starttls | none
  username    String?
  passwordEnc String?
  fromAddress String?
  fromName    String   @default("my-planner")
  // URL pubblico della web app, usato per il link nelle email (opzionale).
  appUrl      String?
  updatedAt   DateTime @updatedAt
}

model Attachment {
  id              String @id @default(cuid())
  taskId          String
  task            Task   @relation(fields: [taskId], references: [id])
  fileName        String
  mimeType        String
  size            Int      @default(0)
  storageBackend  String // local | s3
  storageRef      String
  createdAt       DateTime @default(now())
}

// Log append-only delle azioni sui task (log attivita', vedi
// activityService.ts); solo creazione task, cambio stato e commenti generano
// anche notifiche. `id` autoincrementale e' il cursore usato dal client:
// niente fan-out per utente, il filtro "non le mie azioni" e i permessi di
// progetto vengono applicati in lettura (vedi notificationService.ts).
model TaskEvent {
  id        Int      @id @default(autoincrement())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Scalar senza relation: l'evento deve sopravvivere alla cancellazione del
  // task (il titolo e' denormalizzato in `data`).
  taskId    String?
  // user | mcp | system: il token MCP non identifica un utente, quindi gli
  // eventi via MCP non possono essere filtrati come "fatti da me".
  type      String
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorType String   @default("user")
  data      String   @default("{}") // JSON serializzato (title, from, to, excerpt...)
  createdAt DateTime @default(now())

  @@index([projectId, id])
  @@index([taskId, id])
  @@index([id])
}

// Cursore di lettura per utente: tutto cio' che ha id <= lastSeenEventId e'
// considerato letto. Una sola riga per utente, creata alla prima lettura.
model NotificationState {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenEventId Int      @default(0)
  updatedAt       DateTime @updatedAt
}
