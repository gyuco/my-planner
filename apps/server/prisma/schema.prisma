generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  username     String @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Project {
  id        String   @id @default(cuid())
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  tasks  Task[]
  tokens ProjectToken[]
}

model ProjectToken {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  tokenHash String    @unique
  label     String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

model Task {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])
  parentTaskId String?
  parent       Task?     @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]    @relation("Subtasks")

  title       String
  description String   @default("")
  status      String   @default("draft") // draft | in_progress | done
  priority    String   @default("medium") // low | medium | high | urgent
  complexity  Int?
  tags        String   @default("") // comma-separated
  dueDate     DateTime?
  position    Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments     Comment[]
  attachments  Attachment[]
  blockedBy    TaskDependency[] @relation("BlockedTask")
  blocking     TaskDependency[] @relation("BlockerTask")
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  task            Task   @relation("BlockedTask", fields: [taskId], references: [id])
  blockedByTaskId String
  blockedByTask   Task   @relation("BlockerTask", fields: [blockedByTaskId], references: [id])

  @@unique([taskId, blockedByTaskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Attachment {
  id              String @id @default(cuid())
  taskId          String
  task            Task   @relation(fields: [taskId], references: [id])
  fileName        String
  mimeType        String
  size            Int      @default(0)
  storageBackend  String // local | s3
  storageRef      String
  createdAt       DateTime @default(now())
}
