generator client {
  provider = "prisma-client-js"
}

// Client D1 dedicato al runtime Cloudflare Workers (CF2): usa i driver
// adapter (@prisma/adapter-d1) e il query compiler WASM (engineType "client"),
// quindi nessun engine binario Node da bundle. Il client classico per
// Node/SQLite resta quello sopra (default, @prisma/client).
generator clientD1 {
  provider        = "prisma-client-js"
  output          = "./d1client"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  // L'email e' l'unico identificativo di accesso (sostituisce lo username).
  // Unica e sempre valorizzata: usata per il login e mostrata nel profilo.
  email        String @unique
  passwordHash String
  // Dati anagrafici mostrati nella pagina profilo. I default vuoti mantengono
  // validi gli utenti creati prima dell'introduzione del profilo (la UI fa
  // fallback sull'email quando nome/cognome non sono stati compilati).
  firstName    String @default("")
  lastName     String @default("")
  // Ruolo applicativo: "admin" vede/modifica tutto, "manager" accede solo ai
  // progetti associati tramite UserProject. Default "admin" perche' il primo
  // utente creato al bootstrap e gli utenti pre-ruoli sono amministratori.
  role         String @default("admin")
  // Avatar caricato dall'utente: data URL (immagine gia' ridimensionata lato
  // client, max ~256px). Letto solo da GET /auth/me/avatar, mai insieme al
  // contesto di autenticazione caricato a ogni richiesta.
  avatar          String?
  // Versione dell'avatar (istante dell'ultimo upload), esposta in AuthUser
  // come `avatarVersion` per invalidare la cache del client.
  avatarUpdatedAt DateTime?
  createdAt    DateTime @default(now())

  projects UserProject[]
  notificationState NotificationState?
  taskEvents TaskEvent[]
  assignedTasks Task[] @relation("TaskAssignee")
  ownedTasks    Task[] @relation("TaskOwner")
  mcpTokens     UserMcpToken[]
  aiWatchedTasks Task[] @relation("TaskAiWatcher")
  pushSubscriptions PushSubscription[]
}

// Associazione manager <-> progetto (molti-a-molti). Per gli admin non viene
// usata: il ruolo admin ha accesso implicito a tutti i progetti.
model UserProject {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([projectId])
}

model Project {
  id        String   @id @default(cuid())
  name      String
  archived  Boolean  @default(false)
  // Repository GitHub del progetto (https://github.com/owner/repo): dove gli
  // agenti AI (coder/reviewer) lavorano. Facoltativo.
  repoUrl   String?
  // Gruppo (solo visuale): nella sidebar i progetti con lo stesso nome di
  // gruppo stanno in un contenitore apribile/richiudibile. null = nessun gruppo.
  groupName String?
  // Avvio automatico dei passi AI (routine di Claude Code con trigger API):
  // id della routine (trig_...) e token del trigger, cifrato con secretBox.
  // Il token in chiaro non esce mai dal server.
  aiRoutineId             String?
  aiRoutineTokenEncrypted String?
  aiRoutineLastFiredAt    DateTime?
  aiRoutineLastError      String?
  aiRoutineLastSessionUrl String?
  createdAt DateTime @default(now())

  tasks    Task[]
  tokens   ProjectToken[]
  members  UserProject[]
  events   TaskEvent[]
  statuses ProjectStatus[]
}

// Stato personalizzato di un progetto (es. "bloqueante"), in aggiunta ai 5
// stati di base (draft | todo | in_progress | testing | done) che non sono
// salvati qui e non si possono cancellare. `key` e' generata dall'etichetta
// alla creazione e non cambia piu': Task.status salva la chiave, quindi
// rinominare (label) non tocca i task. Colonne ordinate per `position`.
model ProjectStatus {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  label     String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([projectId, key])
}

model ProjectToken {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id])
  tokenHash String    @unique
  label     String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

// Token MCP globale di un utente: accesso a tutti i progetti che l'utente
// vede (admin: tutti, manager: quelli in UserProject), valutati a ogni
// richiesta. Si ottiene SOLO col login web OAuth (/authorize con email e
// password), mai copiandolo dalla UI; la UI lo elenca e lo revoca.
model UserMcpToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

model Task {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id])

  title       String
  description String   @default("")
  status      String   @default("draft") // draft | todo | in_progress | testing | done | ProjectStatus.key
  type        String   @default("feature") // bug | feature | analysis
  priority    String   @default("medium") // low | medium | high | urgent
  complexity  Int?
  tags        String   @default("") // comma-separated
  dueDate     DateTime?
  position    Int      @default(0)

  // Assegnatario (opzionale) e owner, cioe' chi ha creato il task (null se
  // creato via MCP/sistema). Non limitano la visibilita': servono a filtri
  // come "assegnati a me". SetNull: cancellare un utente lascia i suoi task
  // senza assegnatario/owner invece di eliminarli.
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  ownerId    String?
  owner      User?   @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // Gestione AI (solo admin): il task e' lavorato da un modello nei passi
  // scelti, ciascuno legato a una colonna di partenza: triage su draft (->
  // todo), coder su todo (-> testing), reviewer su testing (-> done o di
  // nuovo todo). aiSteps: CSV ordinato di "triage" | "coder" | "reviewer".
  // aiNotify: "end" | "each" | "none", destinatario aiWatcherId (l'admin che
  // ha attivato la gestione AI). SetNull: cancellare l'utente non tocca il task.
  aiEnabled   Boolean @default(false)
  aiSteps     String  @default("")
  aiNotify    String  @default("end")
  aiWatcherId String?
  aiWatcher   User?   @relation("TaskAiWatcher", fields: [aiWatcherId], references: [id], onDelete: SetNull)
  // Nota libera dell'admin per l'agente (max 4000 caratteri, null = nessuna):
  // passata all'agente in MCP, istruzioni e sessione Claude sul task.
  aiNote      String?
  // Esecuzione (tool MCP ai_*): passo preso in carico da un agente (blocco
  // che scade dopo AI_RUN_TTL_MS), rimandi del reviewer nel giro corrente,
  // fallimento (il task si ferma finche' un admin non riprende o un utente
  // lo sposta).
  aiRunStep      String?
  aiRunStartedAt DateTime?
  aiRejectCount  Int       @default(0)
  aiFailedAt     DateTime?
  aiFailReason   String?
  // Ultimo avvio automatico (routine) per il passo in attesa: evita di
  // avviare piu' sessioni per lo stesso passo.
  aiDispatchedStep String?
  aiDispatchedAt   DateTime?
  aiSessionUrl     String?

  // Sotto-task: un solo livello di annidamento (una subtask non puo' a sua
  // volta avere subtasks, vedi validazione in taskService.ts). Nessun
  // onDelete cascade: deleteTask rifiuta la cancellazione di un parent con
  // subtasks ancora presenti, cosi' non si perdono dati per errore.
  parentId String?
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id])
  subtasks Task[]  @relation("Subtasks")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments     Comment[]
  attachments  Attachment[]
  blockedBy    TaskDependency[] @relation("BlockedTask")
  blocking     TaskDependency[] @relation("BlockerTask")

  @@index([assigneeId])
  @@index([ownerId])
  @@index([aiEnabled])
  @@index([projectId, status, position])
  @@index([parentId])
  @@index([status, updatedAt])
}

model TaskDependency {
  id              String @id @default(cuid())
  taskId          String
  task            Task   @relation("BlockedTask", fields: [taskId], references: [id])
  blockedByTaskId String
  blockedByTask   Task   @relation("BlockerTask", fields: [blockedByTaskId], references: [id])

  @@unique([taskId, blockedByTaskId])
  @@index([blockedByTaskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// Singleton (id sempre "singleton"): configurazione globale del backend di
// storage per gli allegati, modificabile da UI invece che solo via .env
// (vedi apps/server/src/lib/attachmentStorage/index.ts).
model StorageSettings {
  id               String   @id @default("singleton")
  backend          String   @default("local") // local | s3
  localDir         String   @default("./attachments/local")
  s3Endpoint       String?
  s3Bucket         String?
  s3Region         String?
  s3AccessKeyId    String?
  s3SecretAccessKey String?
  updatedAt        DateTime @updatedAt
}

// Singleton (id sempre "singleton"): configurazione SMTP per le email di
// notifica, modificabile dalla UI admin. La password non e' mai salvata in
// chiaro: `passwordEnc` e' cifrata AES-GCM con una chiave derivata da
// SETTINGS_ENCRYPTION_KEY (fallback JWT_SECRET), vedi lib/secretBox.ts.
// Riga assente / `enabled` false / campi incompleti => nessuna email inviata.
model EmailSettings {
  id          String   @id @default("singleton")
  enabled     Boolean  @default(false)
  host        String?
  port        Int      @default(465)
  security    String   @default("tls") // tls | starttls | none
  username    String?
  passwordEnc String?
  fromAddress String?
  fromName    String   @default("my-planner")
  // URL pubblico della web app, usato per il link nelle email (opzionale).
  appUrl      String?
  updatedAt   DateTime @updatedAt
}

// Assistente vocale (Gemini Live, singleton, admin-only). apiKeyEnc contiene la
// chiave Google AI Studio cifrata (AES-GCM, vedi src/lib/secretBox.ts): non
// esce mai dalle API, il browser riceve solo token effimeri.
model VoiceSettings {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(false)
  apiKeyEnc String?
  model     String   @default("gemini-3.8-live")
  voiceName String?
  updatedAt DateTime @updatedAt
}

model Attachment {
  id              String @id @default(cuid())
  taskId          String
  task            Task   @relation(fields: [taskId], references: [id])
  fileName        String
  mimeType        String
  size            Int      @default(0)
  storageBackend  String // local | s3
  storageRef      String
  createdAt       DateTime @default(now())
}

// Log append-only delle azioni sui task (log attivita', vedi
// activityService.ts); solo creazione task, cambio stato e commenti generano
// anche notifiche. `id` autoincrementale e' il cursore usato dal client:
// niente fan-out per utente, il filtro "non le mie azioni" e i permessi di
// progetto vengono applicati in lettura (vedi notificationService.ts).
model TaskEvent {
  id        Int      @id @default(autoincrement())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Scalar senza relation: l'evento deve sopravvivere alla cancellazione del
  // task (il titolo e' denormalizzato in `data`).
  taskId    String?
  // user | mcp | system: il token MCP non identifica un utente, quindi gli
  // eventi via MCP non possono essere filtrati come "fatti da me".
  type      String
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorType String   @default("user")
  // Utente da notificare (in-app + email), deciso quando l'evento viene
  // scritto: l'assegnatario del task, se non e' lui l'autore dell'azione
  // (vedi taskService.notifyAssignee). Null = nessuna notifica. Scalar senza
  // relation: se l'utente viene cancellato le sue notifiche non servono piu'.
  recipientId String?
  data      String   @default("{}") // JSON serializzato (title, from, to, excerpt...)
  createdAt DateTime @default(now())

  @@index([projectId, id])
  @@index([taskId, id])
  @@index([recipientId, id])
  @@index([id])
}

// Cursore di lettura per utente: tutto cio' che ha id <= lastSeenEventId e'
// considerato letto. Una sola riga per utente, creata alla prima lettura.
model NotificationState {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenEventId Int      @default(0)
  updatedAt       DateTime @updatedAt
}

// Dispositivo (browser) registrato per le notifiche push di un utente.
// `endpoint` e' l'URL del push service del browser: unico, perche' un
// browser re-iscritto con un altro utente passa a quell'utente.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  // Lingua dei testi delle notifiche per questo dispositivo (it | en | es).
  locale        String    @default("it")
  label         String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}

// Chiavi VAPID dell'applicazione (riga unica id = "default"), generate al
// primo uso. La privata e' cifrata con secretBox (SETTINGS_ENCRYPTION_KEY /
// JWT_SECRET): il DB da solo non basta per inviare push a nome dell'app.
model PushSettings {
  id                  String   @id @default("default")
  publicKey           String
  privateKeyEncrypted String
  createdAt           DateTime @default(now())
}
